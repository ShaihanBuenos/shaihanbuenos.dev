#!/usr/bin/env bash
# The full check of the site, in one command: format, lint, types, tests and build.
set -euo pipefail

cd "$(dirname "$0")/.."

step() {
  local name=$1 command=$2
  echo "==> $name: $command"
  if ! bash -c "$command"; then
    echo "✗ the check failed at: $name" >&2
    exit 1
  fi
}

# Generates the types of Astro's virtual modules, which lint and the type check use.
step sync 'npx astro sync'
step format 'npx prettier --check .'
step lint 'npx eslint . --max-warnings 0'
step types 'npx astro check'
# `npm test` builds the site before running the tests.
step tests 'npm test'
echo "✓ check passed"
