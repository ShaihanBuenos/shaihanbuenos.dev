---
import type { ComponentProps } from "astro/types";
import "../styles/reading.css";
import Base from "./Base.astro";

// The slot "header" holds what follows the title inside the header: the
// summary and the captions of a text. The slot "head" goes on to the layout.
// The page says about itself what every page says: see Base.astro.
type Props = ComponentProps<typeof Base>;

const { title } = Astro.props;
---

<Base {...Astro.props}>
  <slot name="head" slot="head" />
  <div class="reading">
    <header class="reading-header">
      <h1>{title}</h1>
      <slot name="header" />
    </header>
    <slot />
  </div>
</Base>
