---
import "../styles/fonts.css";
import "../styles/base.css";
import "../styles/frame.css";
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu.astro";
import { INDEXABLE } from "../lib/config.ts";
import { phrasesOf } from "../lib/content.ts";
import { languageOf, HTML_LANG } from "../lib/languages.ts";

interface Props {
  title: string;
  // Where the language button leads, when the path of the page does not
  // tell it: the page of a text gives it.
  equivalent?: string | undefined;
}

const { title, equivalent } = Astro.props;
const language = languageOf(Astro.currentLocale);
const phrases = await phrasesOf(language);
---

<!doctype html>
<html lang={HTML_LANG[language]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!INDEXABLE && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#content">
      {phrases.common.skip}
    </a>
    <div class="page">
      <div class="frame">
        <Menu equivalent={equivalent} />
        <main id="content">
          <slot />
        </main>
        <Footer />
      </div>
      <div class="teeth" aria-hidden="true"></div>
    </div>
  </body>
</html>
