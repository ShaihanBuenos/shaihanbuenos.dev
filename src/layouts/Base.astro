---
import "../styles/fontes.css";
import "../styles/base.css";
import "../styles/moldura.css";
import Menu from "../components/Menu.astro";
import Rodape from "../components/Rodape.astro";
import { PODE_SER_INDEXADO } from "../lib/configuracao.ts";
import { FRASES } from "../lib/frases.ts";
import { idiomaDe, LANG_HTML } from "../lib/idiomas.ts";

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
const idioma = idiomaDe(Astro.currentLocale);
---

<!doctype html>
<html lang={LANG_HTML[idioma]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!PODE_SER_INDEXADO && <meta name="robots" content="noindex" />}
    <title>{titulo}</title>
  </head>
  <body>
    <a class="pular" href="#conteudo">
      {FRASES[idioma].pular}
    </a>
    <div class="pagina">
      <div class="moldura">
        <Menu />
        <main id="conteudo">
          <slot />
        </main>
        <Rodape />
      </div>
      <div class="dentes" aria-hidden="true"></div>
    </div>
  </body>
</html>
