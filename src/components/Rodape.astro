---
import { frasesDe } from "../lib/conteudo.ts";
import { CONTATO } from "../lib/contato.ts";
import { enderecoDoFeed } from "../lib/feed.ts";
import { idiomaDe } from "../lib/idiomas.ts";

const idioma = idiomaDe(Astro.currentLocale);
const frases = await frasesDe(idioma);
---

<footer class="rodape">
  <span>Shaihan Buenos · Porto Alegre</span>
  <ul>
    {CONTATO.map(({ nome, endereco }) => (
      <li>
        <a href={endereco}>{nome}</a>
      </li>
    ))}
    <li>
      <a href={enderecoDoFeed(idioma)}>{frases.comum.feed}</a>
    </li>
  </ul>
</footer>
