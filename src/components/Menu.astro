---
import LanguageButton from "./LanguageButton.astro";
import { phrasesOf } from "../lib/content.ts";
import { languageOf } from "../lib/languages.ts";
import { pathOf, pageAt, MENU_PAGES } from "../lib/pages.ts";

const language = languageOf(Astro.currentLocale);
const phrases = await phrasesOf(language);
const currentPage = pageAt(Astro.url.pathname);
---

<nav class="menu" aria-label={phrases.common.menu}>
  <a
    class="home"
    href={pathOf("home", language)}
    aria-label={`${phrases.home.name}, Shaihan Buenos`}
    aria-current={currentPage === "home" ? "page" : undefined}
  >
    <span class="full-name">Shaihan Buenos</span>
    <span class="initials">SB</span>
  </a>
  <ul>
    {MENU_PAGES.map((page) => (
      <li>
        <a href={pathOf(page, language)} aria-current={page === currentPage ? "page" : undefined}>
          {phrases[page].name}
        </a>
      </li>
    ))}
  </ul>
  <LanguageButton />
</nav>

<script>
  // On a phone, the pages sit in a strip that scrolls sideways: bring the
  // current page into the strip when it starts off screen.
  document
    .querySelector('.menu li [aria-current="page"]')
    ?.scrollIntoView({ inline: "center", block: "nearest" });
</script>
