---
import LanguageButton from "./LanguageButton.astro";
import { phrasesOf } from "../lib/content.ts";
import { languageOf } from "../lib/languages.ts";
import { pathOf, pageAt, sectionAt, MENU_PAGES } from "../lib/pages.ts";

interface Props {
  // Where the language button leads, when the path of the page does not tell it.
  equivalent?: string | undefined;
}

const { equivalent } = Astro.props;
const language = languageOf(Astro.currentLocale);
const phrases = await phrasesOf(language);
const currentPage = pageAt(Astro.url.pathname);
// On a page that is not on the menu, as a project story, the page above it.
const currentSection = sectionAt(Astro.url.pathname);

function ariaCurrentOf(page: (typeof MENU_PAGES)[number]): "page" | "true" | undefined {
  if (page === currentPage) return "page";
  return page === currentSection ? "true" : undefined;
}
---

<nav class="menu" aria-label={phrases.common.menu}>
  <a
    class="home"
    href={pathOf("home", language)}
    aria-label={`${phrases.home.name}, Shaihan Buenos`}
    aria-current={currentPage === "home" ? "page" : undefined}
  >
    <span class="full-name">Shaihan Buenos</span>
    <span class="initials">SB</span>
  </a>
  <ul>
    {MENU_PAGES.map((page) => (
      <li>
        <a href={pathOf(page, language)} aria-current={ariaCurrentOf(page)}>
          {phrases[page].name}
        </a>
      </li>
    ))}
  </ul>
  <LanguageButton equivalent={equivalent} />
</nav>

<script>
  // On a phone, the pages sit in a strip that scrolls sideways: bring the
  // marked page into the strip when it starts off screen.
  document
    .querySelector(".menu li [aria-current]")
    ?.scrollIntoView({ inline: "center", block: "nearest" });
</script>
