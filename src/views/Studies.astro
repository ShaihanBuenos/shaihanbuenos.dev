---
import ResearchTitle from "../components/ResearchTitle.astro";
import TextItem from "../components/TextItem.astro";
import Reading from "../layouts/Reading.astro";
import { type Study, content } from "../lib/content.ts";
import { monthIn } from "../lib/dates.ts";
import { languageOf } from "../lib/languages.ts";
import { aboutSectionPathOf, projectPathOf, researchItemPathOf } from "../lib/pages.ts";

const language = languageOf(Astro.currentLocale);
const { pages, projects, research, studies, studyList, texts } = await content();
const phrases = pages[language];

// What the links of a study lead to. `links.texts` already names the texts
// to show, in their order and without the drafts.
function linksOf({ links }: Study) {
  return {
    texts: links.texts.flatMap((linked) => texts.find(({ id }) => id === linked) ?? []),
    project: projects.find(({ id }) => id === links.project),
    certificate: links.certificate,
    education: links.education,
    research: research.filter(({ id }) => links.research.includes(id)),
  };
}

// The certificate is the only link that leaves the site: it shows where it
// leads, as "example.com".
function siteOf(address: string): string {
  return new URL(address).hostname.replace(/^www\./, "");
}

// The groups of the page: the studies in progress first, then the completed
// ones under the year they were completed, from the most recent year to the
// oldest. A study in progress has no end, so its group has no year. A group
// without studies is not shown.
const byYear = Map.groupBy(
  studies.map((study) => ({ ...study, shownLinks: linksOf(study) })),
  ({ end }) => end?.slice(0, 4),
);
const years = [...byYear.keys()]
  .filter((year) => year !== undefined)
  .sort()
  .reverse();
const groups = [undefined, ...years].flatMap((year) => {
  const studies = byYear.get(year);
  return studies ? [{ year, studies }] : [];
});
---

<Reading title={phrases.studies.name} description={phrases.studies.description}>
  <p slot="header" class="caption">
    {phrases.studies.checkedOn}{" "}
    <time datetime={studyList.checkedOn}>{monthIn(studyList.checkedOn, language)}</time>
  </p>

  {groups.map(({ year, studies }) => (
    <section class="study-group">
      <h2>
        {year === undefined ? (
          phrases.studies.inProgress
        ) : (
          <>
            {phrases.studies.completedIn} <time datetime={year}>{year}</time>
          </>
        )}
      </h2>
      {studies.map(({ shownLinks: links, ...study }) => (
        <article class="study" id={study.id}>
          <h3>{study.name[language]}</h3>
          <p class="goal">{study.goal[language]}</p>
          <p class="caption captions">
            <span class:list={["study-status", study.status]}>
              {phrases.studies.statuses[study.status]}
            </span>
            {study.end === undefined ? (
              <span>
                {phrases.studies.since}{" "}
                <time datetime={study.start}>{monthIn(study.start, language)}</time>
              </span>
            ) : (
              <span>
                <time datetime={study.start}>{monthIn(study.start, language)}</time> –{" "}
                <time datetime={study.end}>{monthIn(study.end, language)}</time>
              </span>
            )}
          </p>
          {(links.texts.length > 0 ||
            links.project ||
            links.certificate ||
            links.education ||
            links.research.length > 0) && (
            <dl class="study-links">
              {links.texts.length > 0 && (
                <>
                  <dt class="caption">{phrases.studies.links.texts}</dt>
                  <dd>
                    <ul class="text-list">
                      {links.texts.map((text) => (
                        <TextItem text={text} level={4} />
                      ))}
                    </ul>
                  </dd>
                </>
              )}
              {links.project && (
                <>
                  <dt class="caption">{phrases.studies.links.project}</dt>
                  <dd>
                    <a href={projectPathOf(links.project.id, language)}>{links.project.name}</a>
                  </dd>
                </>
              )}
              {links.certificate && (
                <>
                  <dt class="caption">{phrases.studies.links.certificate}</dt>
                  <dd>
                    <a href={links.certificate}>{siteOf(links.certificate)}</a>
                  </dd>
                </>
              )}
              {links.education && (
                <>
                  <dt class="caption">{phrases.studies.links.education}</dt>
                  <dd>
                    <a href={aboutSectionPathOf("education", language)}>
                      {phrases.about.education}
                    </a>
                  </dd>
                </>
              )}
              {links.research.length > 0 && (
                <>
                  <dt class="caption">{phrases.studies.links.research}</dt>
                  <dd>
                    {links.research.map((item) => (
                      <a href={researchItemPathOf(item.id, language)}>
                        <ResearchTitle item={item} />
                      </a>
                    ))}
                  </dd>
                </>
              )}
            </dl>
          )}
        </article>
      ))}
    </section>
  ))}
</Reading>
