---
import TextItem from "../components/TextItem.astro";
import Reading from "../layouts/Reading.astro";
import { content } from "../lib/content.ts";
import { languageOf } from "../lib/languages.ts";

const language = languageOf(Astro.currentLocale);
const { pages, texts } = await content();
const phrases = pages[language];
---

<Reading title={phrases.writing.name} description={phrases.writing.description}>
  <ul class="text-list">
    {texts.map((text) => (
      <TextItem text={text} level={2} />
    ))}
  </ul>
</Reading>
